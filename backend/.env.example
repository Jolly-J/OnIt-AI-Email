# ==============================================================================
# 知了 · AI 企业智能邮件工作台环境配置文件示例
# 复制本文件为 .env 并在其中配置您的参数: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI 接口配置 (DeepSeek 开放平台: https://platform.deepseek.com)
# ------------------------------------------------------------------------------
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ------------------------------------------------------------------------------
# 2. 系统安全密钥与数据加密
# 注意：生产环境请使用下方命令独立生成随机密钥，切勿使用任何公开默认值！
# SECRET_KEY 生成命令: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# ENCRYPTION_KEY 生成命令: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ------------------------------------------------------------------------------
SECRET_KEY=your_random_secret_jwt_key_here
ENCRYPTION_KEY=your_fernet_encryption_key_here

# ------------------------------------------------------------------------------
# 3. 企业品牌与公司中英文名称 (用于 AI 拟稿落款、签名与日历生产商)
# ------------------------------------------------------------------------------
COMPANY_NAME=示例科技有限公司
COMPANY_NAME_EN=Acme Corporation
COMPANY_DOMAIN=example.com

# ------------------------------------------------------------------------------
# 4. 数据库与邮件轮询
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./email_assistant.db
# 后台轮询探测新邮件间隔（秒，推荐 10-60 秒）
POLL_INTERVAL_SECONDS=10

# ------------------------------------------------------------------------------
# 5. 开源体验与演示模式 (Mock Mode)
# 若设为 true，或者未配置下方钉钉参数时，系统将自动提供“一键体验演示登录”通道，
# 无需申请钉钉企业应用即可在浏览器中完整体验邮件工作台与 AI 协同功能。
# ------------------------------------------------------------------------------
MOCK_MODE=false

# ------------------------------------------------------------------------------
# 6. 钉钉开放平台对接 (企业内部应用，可选)
# 官网: https://open.dingtalk.com
# ------------------------------------------------------------------------------
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_CORP_ID=
DINGTALK_AGENT_ID=
# 超级管理员钉钉 userid 列表（多个以英文逗号分隔）
DINGTALK_ADMIN_USERIDS=
# 钉钉互动卡片模板 ID（留空则不投放卡片）
DINGTALK_CARD_TEMPLATE_ID=
# 钉钉机器人 Code（默认可与 Client ID 一致）
DINGTALK_ROBOT_CODE=

# ------------------------------------------------------------------------------
# 7. 应用访问地址 (用于钉钉卡片 AppLink 跳转)
# ------------------------------------------------------------------------------
APP_BASE_URL=http://127.0.0.1:4667

# ------------------------------------------------------------------------------
# 8. 泛微 OA 会议室对接 (可选，用于邮件敲定会议时联动占用物理会议室)
# ------------------------------------------------------------------------------
OA_BASE_URL=
OA_AUTH_USERNAME=
OA_AUTH_PASSWORD=
# 自定义备用物理会议室 JSON 数组（可选）
# OA_ROOMS_JSON=[{"id":"1","name":"1号会议室(8人)","capacity":8,"building":"A座","floor":"2F"}]
