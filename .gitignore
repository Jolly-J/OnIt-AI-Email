# 日志文件 (宝塔排错/生产产生)
logs/
*.log

# Python 虚拟环境与缓存
__pycache__/
*.py[cod]
*$py.class
backend/.venv/
.venv/
env/
venv/

# 数据库文件 (开发测试数据不提交)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# 前端依赖与产物 (已有 dist 或依打包流程构建)
frontend/node_modules/
frontend/.pnpm-store/
node_modules/
dist/

# 敏感环境变量与凭据
.env
.env.local
.env.*.local
frontend/.env

# 系统临时文件
.DS_Store
Thumbs.db

# 业务运行与大附件暂存数据 (保持空目录占位)
data/large_attachments/*
!data/large_attachments/.gitkeep

# AI Agent 本地技能与配置
.agents/
skills-lock.json

# 本地文档与规划草稿
docs/*
!docs/images/
品牌资源/



